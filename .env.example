# ---- EMS local environment sample -------------------------------------------
# Copy this file to `.env` and adjust.  `.env` is git-ignored.

# Database backend: sqlite (default, zero setup) or mysql
EMS_DATABASE=sqlite

# Secret key used to sign the session cookie
EMS_SECRET_KEY=change-this-in-production

# Only needed when EMS_DATABASE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ems_user
MYSQL_PASSWORD=ems_password
MYSQL_DATABASE=ems
